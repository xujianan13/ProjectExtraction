    public sealed partial class ProjectExpeditionPlayModeTests
    {
        [Serializable]
        private sealed class PersistenceMetricDistribution
        {
            public double P50;
            public double P95;
            public double Maximum;
        }

        [Serializable]
        private sealed class PersistenceMetricReport
        {
            public string Environment;
            public string UnityVersion;
            public string OperatingSystem;
            public string Processor;
            public string Backend;
            public string ConfigVersion;
            public string MeasurementNotes;
            public int RequestedTicks;
            public long InitialTick;
            public long ActualTicks;
            public long ColdRestoredTick;
            public long ColdRestoreTickDifference;
            public int QueueFreezeCount;
            public int MaxPendingTicks;
            public int ActorCount;
            public long TotalWrittenBytes;
            public int WrittenRecords;
            public double DurationSeconds;
            public double ColdReadMilliseconds;
            public double ColdWorldRestoreMilliseconds;
            public PersistenceMetricDistribution SnapshotEncodingMilliseconds;
            public PersistenceMetricDistribution SynchronousAdvanceMilliseconds;
            public PersistenceMetricDistribution TickToVerifiedHeadMilliseconds;
            public PersistenceMetricDistribution RecordWriteMilliseconds;
            public PersistenceMetricDistribution FullSnapshotBytes;
        }

        private sealed class PersistenceMetricsBackend : ISaveBackend
        {
            [Serializable]
            private sealed class JournalHeadMetric
            {
                public long Revision;
            }

            private const string RunPrefix = "ProjectExtraction/prototype/local/run-state/";
            private readonly FileSaveBackend files;
            public readonly ConcurrentDictionary<long, long> ConfirmedRevisions = new();
            public readonly List<double> WriteMilliseconds = new();
            public long WrittenBytes;
            public int WrittenRecords;
            public string StorageIdentity => files.StorageIdentity;
            public int MaxRecordBytes => files.MaxRecordBytes;

            /// <summary>
            /// 创建只写本次性能测试临时目录的计量文件后端。
            /// </summary>
            /// <param name="directory">已经确定的独立临时目录。</param>
            public PersistenceMetricsBackend(string directory) => files = new FileSaveBackend(directory);

            /// <summary>
            /// 初始化真实文件后端。
            /// </summary>
            /// <returns>文件后端初始化结果。</returns>
            public UniTask<SaveResult> InitializeAsync() => files.InitializeAsync();

            /// <summary>
            /// 读取真实文件并记录单局提交头完整读回的时间。
            /// </summary>
            /// <param name="key">逻辑记录键。</param>
            /// <returns>真实文件读取结果。</returns>
            public async UniTask<SaveReadResult> ReadAsync(string key)
            {
                SaveReadResult result = await files.ReadAsync(key);
                if (result.Status == SaveReadStatus.Found && key.StartsWith(RunPrefix, StringComparison.Ordinal) &&
                    (key.EndsWith("/head-a", StringComparison.Ordinal) || key.EndsWith("/head-b", StringComparison.Ordinal)))
                {
                    long timestamp = Stopwatch.GetTimestamp();
                    JournalHeadMetric head = JsonUtility.FromJson<JournalHeadMetric>(result.Record);
                    ConfirmedRevisions.TryAdd(head.Revision, timestamp);
                }
                return result;
            }

            /// <summary>
            /// 执行真实完整文件写入并累计成功写入的 UTF-8 字节与耗时。
            /// </summary>
            /// <param name="key">逻辑记录键。</param>
            /// <param name="record">完整记录字符串。</param>
            /// <returns>真实文件提交结果。</returns>
            public async UniTask<SaveResult> WriteAsync(string key, string record)
            {
                long timestamp = Stopwatch.GetTimestamp();
                SaveResult result = await files.WriteAsync(key, record);
                double elapsed = PersistenceElapsedMilliseconds(timestamp, Stopwatch.GetTimestamp());
                if (result.Success)
                {
                    Interlocked.Add(ref WrittenBytes, Encoding.UTF8.GetByteCount(record));
                    Interlocked.Increment(ref WrittenRecords);
                    lock (WriteMilliseconds) WriteMilliseconds.Add(elapsed);
                }
                return result;
            }

            /// <summary>
            /// 排空正式准入基线后重新开始性能计量。
            /// </summary>
            public void ResetMetrics()
            {
                ConfirmedRevisions.Clear();
                WriteMilliseconds.Clear();
                WrittenBytes = 0;
                WrittenRecords = 0;
            }
        }

        /// <summary>
        /// 显式启用时采样真实场景完整 tick、文件日志写入和最新快照冷恢复。
        /// </summary>
        /// <returns>仅在环境变量启用时执行的逐帧性能测试。</returns>
        [UnityTest]
        public IEnumerator PersistenceMetrics_FileJournalSurvives3600ActualTicks()
        {
            if (System.Environment.GetEnvironmentVariable("PROJECT_V2_PERSISTENCE_METRICS") != "1") yield break;
            yield return UniTask.ToCoroutine(async () =>
            {
                string temporaryRoot = Path.GetFullPath(Path.GetTempPath()).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
                string temporaryName = "ProjectExtraction-v2-metrics-" + Guid.NewGuid().ToString("N");
                string directory = Path.Combine(temporaryRoot, temporaryName);
                var backend = new PersistenceMetricsBackend(directory);
                try
                {
                    await SetupAsync(backend);
                    Assert.That(await ProjectServices.Coordinator.StartRunAsync(1).Timeout(TimeSpan.FromSeconds(30)), Is.True);
                    ProjectSession session = ProjectServices.Session;
                    ExpeditionRun run = session.CurrentRun;
                    GameEntry.Get<IGameplayModule>().SetPaused(true);
                    Assert.That((await session.WaitForRunSavesAsync().Timeout(TimeSpan.FromSeconds(30))).Success, Is.True);
                    run.World.ClearPendingTime();
                    ProtectMetricsActors(run);
                    RegionSpawnSlotState firstEnemy = run.CurrentRegion.Slots.First(value => value.CurrentActorId > 1);
                    Assert.That(run.World.TryFindActor(firstEnemy.CurrentActorId, out CombatEntityRef enemy), Is.True);
                    Assert.That(TryPlacePlayerNearActor(run, enemy), Is.True);
                    Assert.That(run.TryCaptureState(out ExpeditionRunSnapshot baseline, out string error), Is.True, error);
                    Assert.That((await session.CommitRunStateAsync(baseline)).Success, Is.True);
                    long firstRevision = session.RunJournalRevision;
                    long firstTick = run.World.TickIndex;
                    backend.ResetMetrics();

                    const int requestedTicks = 3600;
                    var started = new List<long>(requestedTicks);
                    var encoding = new List<double>(requestedTicks);
                    var synchronous = new List<double>(requestedTicks);
                    var snapshotBytes = new List<double>(requestedTicks);
                    int freezes = 0;
                    long benchmarkStart = Stopwatch.GetTimestamp();
                    for (int tick = 0; tick < requestedTicks; tick++)
                    {
                        if (session.RunSaveBlocked)
                        {
                            freezes++;
                            Assert.That((await session.WaitForRunSavesAsync().Timeout(TimeSpan.FromSeconds(30))).Success, Is.True);
                        }
                        Assert.That(run.CanAcceptPlayerInput, Is.True, "必须实际推进完整 tick，不能跳过死亡、领奖或保存门禁。");
                        long before = run.World.TickIndex;
                        long timestamp = Stopwatch.GetTimestamp();
                        started.Add(timestamp);
                        run.Advance(CombatWorld.TickSeconds);
                        synchronous.Add(PersistenceElapsedMilliseconds(timestamp, Stopwatch.GetTimestamp()));
                        Assert.That(run.World.TickIndex, Is.EqualTo(before + 1));
                        timestamp = Stopwatch.GetTimestamp();
                        Assert.That(run.TryCaptureState(out ExpeditionRunSnapshot snapshot, out error), Is.True, error);
                        Assert.That(ExpeditionSnapshotCodec.TryEncode(snapshot, out _, out error), Is.True, error);
                        encoding.Add(PersistenceElapsedMilliseconds(timestamp, Stopwatch.GetTimestamp()));
                        snapshotBytes.Add(Encoding.UTF8.GetByteCount(JsonUtility.ToJson(snapshot)));
                    }
                    Assert.That((await session.WaitForRunSavesAsync().Timeout(TimeSpan.FromSeconds(30))).Success, Is.True);
                    double duration = PersistenceElapsedMilliseconds(benchmarkStart, Stopwatch.GetTimestamp()) / 1000d;
                    long actualTicks = run.World.TickIndex - firstTick;
                    Assert.That(actualTicks, Is.EqualTo(requestedTicks));
                    Assert.That(session.RunJournalRevision - firstRevision, Is.EqualTo(requestedTicks));
                    Assert.That(run.IsRunning && run.PendingRogueChoice == null && run.PendingBossChoice == null, Is.True);
                    Assert.That(run.CaptureStatistics().EnemyKills, Is.Zero);
                    var confirmed = new List<double>(requestedTicks);
                    for (int tick = 0; tick < requestedTicks; tick++)
                    {
                        Assert.That(backend.ConfirmedRevisions.TryGetValue(firstRevision + tick + 1, out long timestamp), Is.True);
                        confirmed.Add(PersistenceElapsedMilliseconds(started[tick], timestamp));
                    }

                    Assert.That(run.TryCaptureState(out ExpeditionRunSnapshot finalSnapshot, out error), Is.True, error);
                    long coldStart = Stopwatch.GetTimestamp();
                    var coldJournal = new SaveStateJournal(backend, "ProjectExtraction/prototype/local/run-state",
                        GameTables.CfgRunPersistence.GetById(1).CheckpointTicks, GameTables.CfgRunPersistence.GetById(1).MaxStateBytes);
                    SaveJournalLoadResult loaded = await coldJournal.LoadAsync(run.RunId);
                    Assert.That(loaded.Result.Success && !loaded.Missing, Is.True, loaded.Result.Message);
                    Assert.That(ExpeditionSnapshotCodec.TryDecode(loaded.Components, out ExpeditionRunSnapshot cold, out error), Is.True, error);
                    double coldRead = PersistenceElapsedMilliseconds(coldStart, Stopwatch.GetTimestamp());
                    string loadedState = JsonUtility.ToJson(cold);
                    AssertPersistedMetricsSnapshot(finalSnapshot, cold);
                    coldStart = Stopwatch.GetTimestamp();
                    Assert.That(ExpeditionRun.TryRestore(session, cold, out ExpeditionRun restored, out error), Is.True, error);
                    double coldWorld = PersistenceElapsedMilliseconds(coldStart, Stopwatch.GetTimestamp());
                    using (restored)
                    {
                        Assert.That(restored.TryCaptureState(out ExpeditionRunSnapshot recaptured, out error), Is.True, error);
                        Assert.That(JsonUtility.ToJson(cold), Is.EqualTo(loadedState), "恢复过程不得改写已解码的存档候选。");
                        Assert.That(JsonUtility.ToJson(recaptured), Is.EqualTo(loadedState), "恢复后全部字段必须与已解码快照精确一致。");
                    }

                    var report = new PersistenceMetricReport
                    {
                        Environment = Application.isEditor ? "Unity Editor host" : Application.platform.ToString(),
                        UnityVersion = Application.unityVersion, OperatingSystem = SystemInfo.operatingSystem,
                        Processor = SystemInfo.processorType, Backend = "FileSaveBackend: unique temporary directory",
                        ConfigVersion = finalSnapshot.ConfigVersion, RequestedTicks = requestedTicks, InitialTick = firstTick,
                        ActualTicks = actualTicks, ColdRestoredTick = cold.World.Tick,
                        ColdRestoreTickDifference = finalSnapshot.World.Tick - cold.World.Tick,
                        QueueFreezeCount = freezes, MaxPendingTicks = GameTables.CfgRunPersistence.GetById(1).MaxPendingTicks,
                        ActorCount = finalSnapshot.World.Actors.Count, TotalWrittenBytes = backend.WrittenBytes,
                        WrittenRecords = backend.WrittenRecords, DurationSeconds = duration,
                        ColdReadMilliseconds = coldRead, ColdWorldRestoreMilliseconds = coldWorld,
                        SnapshotEncodingMilliseconds = PersistenceDistribution(encoding),
                        SynchronousAdvanceMilliseconds = PersistenceDistribution(synchronous),
                        TickToVerifiedHeadMilliseconds = PersistenceDistribution(confirmed),
                        RecordWriteMilliseconds = PersistenceDistribution(backend.WriteMilliseconds),
                        FullSnapshotBytes = PersistenceDistribution(snapshotBytes),
                        MeasurementNotes = "Unity host measurement only: unthrottled batch tick stress sampling, not a real-time 60fps metric. " +
                            "Actors receive 1,000,000 health and defense bonuses to keep combat alive without rewards; " +
                            "automatic gameplay dispatch is paused while every tick is advanced explicitly. Encoding is an additional capture+codec sample; " +
                            "queue freezes and tick confirmation latency include FIFO waiting plus extra capture/codec/JSON sampling overhead. " +
                            "Written bytes exclude admission baseline."
                    };
                    string output = Path.GetFullPath(Path.Combine(Application.dataPath, "../../Verification/v2-persistence/metrics.json"));
                    Directory.CreateDirectory(Path.GetDirectoryName(output));
                    File.WriteAllText(output, JsonUtility.ToJson(report, true), new UTF8Encoding(false));
                    TestContext.Progress.WriteLine("Persistence metrics: " + output);
                }
                finally
                {
                    if (ProjectServices.Coordinator != null) await ProjectServices.Coordinator.CloseAsync();
                    GameEntry.StopFramework();
                    if (Directory.Exists(directory))
                    {
                        string resolved = Path.GetFullPath(directory);
                        Assert.That(Path.GetDirectoryName(resolved), Is.EqualTo(temporaryRoot));
                        Assert.That(Path.GetFileName(resolved), Is.EqualTo(temporaryName));
                        Directory.Delete(resolved, true);
                    }
                }
            });
        }

        /// <summary>
        /// 只允许三项统计双精度数在 JSON 往返后产生绝对值不超过万亿分之一的误差，其余完整字段精确比较。
        /// </summary>
        /// <param name="expected">运行对象导出的原始独立快照。</param>
        /// <param name="actual">从真实文件日志解码的完整快照。</param>
        private static void AssertPersistedMetricsSnapshot(ExpeditionRunSnapshot expected, ExpeditionRunSnapshot actual)
        {
            const double statisticsTolerance = 1e-12d;
            Assert.That(actual.Statistics.DamageDealt, Is.EqualTo(expected.Statistics.DamageDealt).Within(statisticsTolerance), "DamageDealt");
            Assert.That(actual.Statistics.DamageTaken, Is.EqualTo(expected.Statistics.DamageTaken).Within(statisticsTolerance), "DamageTaken");
            Assert.That(actual.Statistics.HealingReceived, Is.EqualTo(expected.Statistics.HealingReceived).Within(statisticsTolerance), "HealingReceived");
            ProjectRunStatistics original = expected.Statistics;
            ProjectRunStatistics normalized = original.Copy();
            normalized.DamageDealt = actual.Statistics.DamageDealt;
            normalized.DamageTaken = actual.Statistics.DamageTaken;
            normalized.HealingReceived = actual.Statistics.HealingReceived;
            expected.Statistics = normalized;
            Assert.That(JsonUtility.ToJson(actual), Is.EqualTo(JsonUtility.ToJson(expected)), "除明确归一的三项统计 double 外均须精确一致。");
            expected.Statistics = original;
        }

        /// <summary>
        /// 使用真实属性强化入口保持所有生命存活，避免领奖窗口截断连续 tick 样本。
        /// </summary>
        /// <param name="run">已经进入正式场景的运行对象。</param>
        private static void ProtectMetricsActors(ExpeditionRun run)
        {
            var actors = new List<CombatActorSnapshot>();
            run.World.GetActorsSnapshot(actors);
            foreach (CombatActorSnapshot actor in actors)
            {
                Assert.That(run.World.TryFindActor(actor.ActorId, out CombatEntityRef entity), Is.True);
                Assert.That(run.World.TryAddAttributeBonus(entity, CombatAttributeKind.MaxHealth, 1000000f), Is.True);
                Assert.That(run.World.TryAddAttributeBonus(entity, CombatAttributeKind.Defense, 1000000f), Is.True);
            }
        }

        /// <summary>
        /// 将同一单调时钟的两个读数换算为毫秒。
        /// </summary>
        /// <param name="started">开始时钟读数。</param>
        /// <param name="finished">结束时钟读数。</param>
        /// <returns>真实经过毫秒。</returns>
        private static double PersistenceElapsedMilliseconds(long started, long finished) =>
            (finished - started) * 1000d / Stopwatch.Frequency;

        /// <summary>
        /// 对实际采样排序并按最近秩计算中位数、百分之九十五分位和最大值。
        /// </summary>
        /// <param name="samples">本次实际采样。</param>
        /// <returns>具有相同计量单位的分布摘要。</returns>
        private static PersistenceMetricDistribution PersistenceDistribution(List<double> samples)
        {
            double[] sorted = samples.OrderBy(value => value).ToArray();
            Assert.That(sorted, Is.Not.Empty);
            return new PersistenceMetricDistribution
            {
                P50 = sorted[(int)Math.Ceiling(sorted.Length * 0.5d) - 1],
                P95 = sorted[(int)Math.Ceiling(sorted.Length * 0.95d) - 1], Maximum = sorted[sorted.Length - 1]
            };
        }
    }
}
